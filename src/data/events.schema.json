{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 1.3 Moon Event Catalog Schema (v3)",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/eventNode"
  },
  "$defs": {
    "resourceKey": {
      "type": "string",
      "enum": ["batteryKWh", "oxygenKg", "waterL", "partsKg", "mrePacks", "medkits"]
    },
    "crewId": {
      "type": "string",
      "enum": ["cmd", "eng", "doc", "geo"]
    },
    "systemId": {
      "type": "string",
      "enum": ["solar", "recycler", "scrubber", "airlock", "fabricator"]
    },
    "equipmentId": {
      "type": "string",
      "enum": ["core_drill", "sealant_tape", "solar_lantern", "dust_shield", "radio_repeater", "cryo_thermal_rig"]
    },
    "expeditionId": {
      "type": "string",
      "enum": ["lunar-crater", "regolith-field", "polar-psr"]
    },
    "triggerCondition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sol": { "type": "integer", "minimum": 1, "maximum": 32 },
        "solMin": { "type": "integer", "minimum": 1, "maximum": 32 },
        "solMax": { "type": "integer", "minimum": 1, "maximum": 32 },
        "isLunarNight": { "type": "boolean" },
        "flagSet": { "type": "string", "minLength": 1 },
        "flagNotSet": { "type": "string", "minLength": 1 },
        "flagEquals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "value"],
          "properties": {
            "key": { "type": "string", "minLength": 1 },
            "value": { "type": ["boolean", "string", "number"] }
          }
        },
        "choiceMade": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventId", "choiceId"],
          "properties": {
            "eventId": { "type": "string", "minLength": 1 },
            "choiceId": { "type": "string", "minLength": 1 }
          }
        },
        "eventSeen": { "type": "string", "minLength": 1 },
        "eventNotSeen": { "type": "string", "minLength": 1 },
        "roverExpeditionId": { "$ref": "#/$defs/expeditionId" },
        "roverStatus": {
          "type": "string",
          "enum": ["available", "scheduled", "launching", "outbound", "exploring", "signal-lost", "returning", "completed", "failed"]
        },
        "systemIntegrityBelow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "maxIntegrity"],
          "properties": {
            "id": { "$ref": "#/$defs/systemId" },
            "maxIntegrity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "minResource": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "batteryKWh": { "type": "number", "minimum": 0 },
            "oxygenKg": { "type": "number", "minimum": 0 },
            "waterL": { "type": "number", "minimum": 0 },
            "partsKg": { "type": "number", "minimum": 0 },
            "mrePacks": { "type": "integer", "minimum": 0 },
            "medkits": { "type": "integer", "minimum": 0 }
          }
        },
        "maxResource": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "batteryKWh": { "type": "number", "minimum": 0 },
            "oxygenKg": { "type": "number", "minimum": 0 },
            "waterL": { "type": "number", "minimum": 0 },
            "partsKg": { "type": "number", "minimum": 0 },
            "mrePacks": { "type": "integer", "minimum": 0 },
            "medkits": { "type": "integer", "minimum": 0 }
          }
        },
        "crewCondition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["condition"],
          "properties": {
            "crewId": { "$ref": "#/$defs/crewId" },
            "condition": { "type": "string", "enum": ["fit", "injured", "evacuated"] }
          }
        }
      },
      "not": {
        "anyOf": [
          { "required": ["sol", "solMin"] },
          { "required": ["sol", "solMax"] }
        ]
      }
    },
    "eventEffect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "resource", "delta"],
          "properties": {
            "kind": { "const": "resource" },
            "resource": { "$ref": "#/$defs/resourceKey" },
            "delta": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "delta"],
          "properties": {
            "kind": { "const": "science" },
            "delta": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target"],
          "properties": {
            "kind": { "const": "crew" },
            "target": { "type": "string", "enum": ["cmd", "eng", "doc", "geo", "all"] },
            "healthDelta": { "type": "number" },
            "moraleDelta": { "type": "number" },
            "satietyDelta": { "type": "number" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "equipmentId", "wear"],
          "properties": {
            "kind": { "const": "equipment-wear" },
            "equipmentId": { "$ref": "#/$defs/equipmentId" },
            "wear": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "systemId", "delta"],
          "properties": {
            "kind": { "const": "system-integrity" },
            "systemId": { "$ref": "#/$defs/systemId" },
            "delta": { "type": "number", "minimum": -1, "maximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "plan-override" },
            "wrsEnabled": { "type": "boolean" },
            "extraPowerCostKWh": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "value"],
          "properties": {
            "kind": { "const": "set-flag" },
            "key": { "type": "string", "minLength": 1 },
            "value": { "type": ["boolean", "string", "number"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key"],
          "properties": {
            "kind": { "const": "clear-flag" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "crewId", "task"],
          "properties": {
            "kind": { "const": "assign-task" },
            "crewId": { "$ref": "#/$defs/crewId" },
            "task": {
              "type": "string",
              "enum": ["repair-system", "upgrade-system", "rover-operate", "emergency-response", "medical-care", "rest"]
            },
            "targetSystemId": { "$ref": "#/$defs/systemId" },
            "targetCrewId": { "$ref": "#/$defs/crewId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action"],
          "properties": {
            "kind": { "const": "rover-action" },
            "action": {
              "type": "string",
              "enum": ["continue-expedition", "fail-expedition", "recover-signal", "delay-1-sol"]
            },
            "expeditionId": { "$ref": "#/$defs/expeditionId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "eventId", "delaySols"],
          "properties": {
            "kind": { "const": "schedule-follow-up" },
            "eventId": { "type": "string", "minLength": 1 },
            "delaySols": { "type": "integer", "minimum": 1, "maximum": 31 }
          }
        }
      ]
    },
    "eventChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "effects", "log"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "labelEn": { "type": "string", "minLength": 1 },
        "requiresEquipment": { "$ref": "#/$defs/equipmentId" },
        "requiresFlag": { "type": "string", "minLength": 1 },
        "requiresCrew": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crewId"],
          "properties": {
            "crewId": { "$ref": "#/$defs/crewId" },
            "requireFree": { "type": "boolean" },
            "requireFit": { "type": "boolean" }
          }
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/eventEffect" }
        },
        "log": { "type": "string", "minLength": 1 },
        "logEn": { "type": "string", "minLength": 1 }
      }
    },
    "eventNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "art",
        "priority",
        "weight",
        "repeatPolicy",
        "scienceBriefId",
        "when",
        "mandatory",
        "prompt",
        "choices"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "titleEn": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "enum": ["ops", "hazard", "crisis", "milestone"] },
        "art": { "type": "string", "enum": ["tech-fault", "airlock-leak", "solar-particle", "robot-signal-loss"] },
        "priority": { "type": "integer", "minimum": 1, "maximum": 100 },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "repeatPolicy": { "type": "string", "enum": ["once", "cooldown", "repeatable"] },
        "cooldownSols": { "type": "integer", "minimum": 1, "maximum": 32 },
        "deadlineOffsetSols": { "type": "integer", "minimum": 0, "maximum": 31 },
        "scienceBriefId": { "type": ["string", "null"] },
        "when": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/triggerCondition" }
        },
        "mandatory": { "type": "boolean" },
        "prompt": { "type": "string", "minLength": 1 },
        "promptEn": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/eventChoice" }
        },
        "onExpireEffects": {
          "type": "array",
          "items": { "$ref": "#/$defs/eventEffect" }
        }
      }
    }
  }
}
